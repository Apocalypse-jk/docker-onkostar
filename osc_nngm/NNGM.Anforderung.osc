            <PlausibilityRule>
               <Type>2</Type>
               <Message>Das Datum liegt vor dem Geburtsdatum</Message>
               <Description>__DatumGrenze_requirementDate_GueltigVon</Description>
               <Bezeichnung>__DatumGrenze_requirementDate_GueltigVon</Bezeichnung>
               <Formula>dateBeforeOrEquals(patientData.getBirthdate(), requirementDate)</Formula>
               <Active>true</Active>
               <Editable>false</Editable>
               <Valid>true</Valid>
               <Statusauswirkung>0</Statusauswirkung>
               <DataFormEntries>
                  <EntryName>requirementDate</EntryName>
               </DataFormEntries>
            </PlausibilityRule>
            <PlausibilityRule>
               <Type>2</Type>
               <Message>Das Datum liegt nach dem Sterbedatum</Message>
               <Description>__DatumGrenze_requirementDate_GueltigBis</Description>
               <Bezeichnung>__DatumGrenze_requirementDate_GueltigBis</Bezeichnung>
               <Formula>dateAfterOrEquals(patientData.getDeathdate(), requirementDate)</Formula>
               <Active>true</Active>
               <Editable>false</Editable>
               <Valid>true</Valid>
               <Statusauswirkung>0</Statusauswirkung>
               <DataFormEntries>
                  <EntryName>requirementDate</EntryName>
               </DataFormEntries>
            </PlausibilityRule>
            <PlausibilityRule>
               <Type>2</Type>
               <Message>Das Datum liegt in der Zukunft</Message>
               <Description>__DatumGrenze_requirementDate_GueltigZukunft</Description>
               <Bezeichnung>__DatumGrenze_requirementDate_GueltigZukunft</Bezeichnung>
               <Formula>dateAfterOrEquals(getNow(), requirementDate)</Formula>
               <Active>true</Active>
               <Editable>false</Editable>
               <Valid>true</Valid>
               <Statusauswirkung>0</Statusauswirkung>
               <DataFormEntries>
                  <EntryName>requirementDate</EntryName>
               </DataFormEntries>
