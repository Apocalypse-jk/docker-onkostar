         <Category>-2</Category>
         <Name>NNGM.Systemische Therapie</Name>
         <Version>1</Version>
         <MenuEntry>Systemische Therapie (nNGM)</MenuEntry>
         <Title>Systemische Therapie (nNGM)</Title>
         <Description>Abgeleitet von OS.Systemische Therapie (nNGM, E-8)</Description>
         <Note>Abgeleitet von OS.Systemische Therapie mit mapping/tools/osc-ableitung.mjs; Basis-Datenkatalog Systemtherapie, nNGM-Ergänzungen in NNGMSystemtherapie</Note>
         <Readonly>false</Readonly>
         <Active>true</Active>
         <TudokPosition>306</TudokPosition>
         <Aktenbereich>0</Aktenbereich>
         <BefragungRelevant>false</BefragungRelevant>
         <Summary>&lt;!--INHERIT START-->&amp;#10;&lt;div style=&quot;margin-left:10px&quot;>&amp;#10;&amp;#10;&lt;font style=&quot;font-weight: bold;color: purple&quot;>&amp;#10;&lt;if test=&quot;Therapiearten->isEmpty()&quot;> &lt;then>&amp;#10;Systemtherapie&amp;#10;&lt;/then>&amp;#10;&lt;else>&amp;#10;  &lt;for var=&quot;mc&quot; src=&quot;Therapiearten&quot; varIndex=&quot;i&quot;> &amp;#10;      &lt;if test=&quot;i= 0&quot;>    &amp;#10;          &lt;then>{mc.shortdesc}&lt;/then>&amp;#10;          &lt;else> / {mc.shortdesc}&lt;/else>&amp;#10;        &lt;/if>&amp;#10;  &lt;/for> &amp;#10;&lt;/else>&amp;#10;&lt;/if>&amp;#10;&lt;/font>&amp;#10;&lt;if test=&quot;not isEmptyString(Intention) and not isEmptyString(Relation)&quot;>&amp;#10;&lt;then>({Intention.shortdesc}, {Relation.shortdesc})&lt;/then>&lt;/if>&amp;#10;&lt;if test=&quot;not isEmptyString(Intention) and isEmptyString(Relation)&quot;>&amp;#10;&lt;then>{Intention.shortdesc}&lt;/then>&lt;/if>&amp;#10;&lt;if test=&quot;not isEmptyString(Relation) and isEmptyString(Intention)&quot;>&amp;#10;&lt;then>{Relation.shortdesc}&lt;/then>&lt;/if>&amp;#10;&amp;#10;&lt;if test=&quot;not isEmpty(Ende) and Status='D' and Beendigung &lt;> 'A' &quot;>&amp;#10;  &lt;then>&amp;#10;  &lt;br/>beendet am {Ende}&amp;#10;  &lt;/then>&amp;#10;&lt;/if>&amp;#10;&lt;if test=&quot;isEmpty(Ende) and Status='D' and Beendigung &lt;> 'A' &quot;>&amp;#10;  &lt;then>&amp;#10; &amp;#10;  &lt;/then>&amp;#10;&lt;/if>&amp;#10;&amp;#10;&lt;if test=&quot;Status='D' and Beendigung = 'A' &quot;>&amp;#10;  &lt;then>&amp;#10;  &lt;br/>abgebrochen &amp;#10;  &lt;/then>&amp;#10;&lt;/if>&amp;#10;&lt;if test=&quot;not isEmpty(Ende) and Status='D' and Beendigung = 'A' &quot;>&amp;#10;  &lt;then>&amp;#10;  am {Ende}&amp;#10;  &lt;/then>&amp;#10;&lt;/if>&amp;#10;&lt;if test=&quot;not isEmptyString(GrundAbbruch) and Status='D' and Beendigung = 'A' &quot;>&amp;#10;  &lt;then>&amp;#10;   &amp;nbsp ({GrundAbbruch.shortdesc})&amp;#10;  &lt;/then>&amp;#10;&lt;/if>&amp;#10;&amp;#10;&lt;if test=&quot;Status='N' &quot;>&amp;#10;  &lt;then>&amp;#10;    &lt;br/>Nicht durchgeführt&amp;#10;  &lt;/then>&amp;#10;&lt;/if>&amp;#10;&amp;#10;&lt;if test=&quot;not isEmptyString(Grund) and Status='N' &quot;>&amp;#10;  &lt;then>&amp;#10;   ({Grund.shortdesc})&amp;#10;  &lt;/then>&amp;#10;&lt;/if>&amp;#10;&amp;#10;&lt;if test=&quot;Status='D' and not isEmptyString(Protokoll)&quot;>&amp;#10;  &lt;then>&amp;#10;    &lt;br/>{Protokoll.description}&amp;#10;  &lt;/then>&amp;#10;&lt;/if>&amp;#10;&amp;#10;&lt;if test=&quot;Status='D' and ZyklenDurchgefuehrt>0 and not isEmptyString(Protokoll)&quot;>&amp;#10;  &lt;then>,  &lt;/then>&amp;#10;&lt;/if>&amp;#10;&amp;#10;&lt;if test=&quot;ZyklenDurchgefuehrt>0&quot;>&amp;#10;  &lt;then>&amp;#10;    &lt;if test=&quot;ZyklenDurchgefuehrt=1&quot;>&amp;#10;      &lt;then> 1 Zyklus &lt;/then>&amp;#10;      &lt;else> {ZyklenDurchgefuehrt} Zyklen &lt;/else>&amp;#10;    &lt;/if>&amp;#10;  &lt;/then>&amp;#10;&lt;/if>&amp;#10;&amp;#10;   &lt;if test=&quot;Nebenwirkungen='1' &quot;>&amp;#10;      &lt;then> &lt;br/>Nebenwirkungen aufgetreten&lt;/then> &amp;#10;   &lt;/if>&amp;#10;&amp;#10;&lt;/div>&amp;#10;&lt;!--INHERIT END--></Summary>
         <BigSummary>&lt;!--INHERIT START-->&amp;#10;&lt;div style=&quot;margin-left:20px&quot;>&amp;#10;&amp;#10;&lt;font style=&quot;font-weight: bold;color: purple;font-size: 16px&quot;>&amp;#10;&lt;if test=&quot;Therapiearten->isEmpty()&quot;> &lt;then>&amp;#10;Systemtherapie&amp;#10;&lt;/then>&amp;#10;&lt;else>&amp;#10;  &lt;for var=&quot;mc&quot; src=&quot;Therapiearten&quot; varIndex=&quot;i&quot;> &amp;#10;      &lt;if test=&quot;i= 0&quot;>    &amp;#10;          &lt;then>{mc.shortdesc}&lt;/then>&amp;#10;          &lt;else> / {mc.shortdesc}&lt;/else>&amp;#10;        &lt;/if>&amp;#10;  &lt;/for> &amp;#10;&lt;/else>&amp;#10;&lt;/if>&amp;#10;&lt;/font>&amp;#10;&lt;if test=&quot;not isEmptyString(Intention) and not isEmptyString(Relation)&quot;>&amp;#10;&lt;then>({Intention.shortdesc}, {Relation.shortdesc})&lt;/then>&lt;/if>&amp;#10;&lt;if test=&quot;not isEmptyString(Intention) and isEmptyString(Relation)&quot;>&amp;#10;&lt;then>{Intention.shortdesc}&lt;/then>&lt;/if>&amp;#10;&lt;if test=&quot;not isEmptyString(Relation) and isEmptyString(Intention)&quot;>&amp;#10;&lt;then>{Relation.shortdesc}&lt;/then>&lt;/if>&amp;#10;&amp;#10;&amp;#10;&lt;if test=&quot;not isEmpty(Ende) and Status='D' and Beendigung &lt;> 'A' &quot;>&amp;#10;  &lt;then>&amp;#10;  &lt;br/>beendet am {Ende}&amp;#10;  &lt;/then>&amp;#10;&lt;/if>&amp;#10;&lt;if test=&quot;isEmpty(Ende) and Status='D' and Beendigung &lt;> 'A' &quot;>&amp;#10;  &lt;then>&amp;#10;  &amp;#10;  &lt;/then>&amp;#10;&lt;/if>&amp;#10;&amp;#10;&lt;if test=&quot;Status='D' and Beendigung = 'A' &quot;>&amp;#10;  &lt;then>&amp;#10;  &lt;br/>abgebrochen &amp;#10;  &lt;/then>&amp;#10;&lt;/if>&amp;#10;&lt;if test=&quot;not isEmpty(Ende) and Status='D' and Beendigung = 'A' &quot;>&amp;#10;  &lt;then>&amp;#10;  am {Ende}&amp;#10;  &lt;/then>&amp;#10;&lt;/if>&amp;#10;&lt;if test=&quot;not isEmptyString(GrundAbbruch) and Status='D' and Beendigung = 'A' &quot;>&amp;#10;  &lt;then>&amp;#10;   &amp;nbsp ({GrundAbbruch.shortdesc})&amp;#10;  &lt;/then>&amp;#10;&lt;/if>&amp;#10;&amp;#10;&lt;if test=&quot;Status='N' &quot;>&amp;#10;  &lt;then>&amp;#10;    &lt;br/>Nicht durchgeführt&amp;#10;  &lt;/then>&amp;#10;&lt;/if>&amp;#10;&amp;#10;&lt;if test=&quot;not isEmptyString(Grund) and Status='N' &quot;>&amp;#10;  &lt;then>&amp;#10;   ({Grund.shortdesc})&amp;#10;  &lt;/then>&amp;#10;&lt;/if>&amp;#10;&amp;#10;&lt;if test=&quot;Status='D' and not isEmptyString(Protokoll)&quot;>&amp;#10;  &lt;then>&amp;#10;    &lt;br/>{Protokoll.description}&amp;#10;  &lt;/then>&amp;#10;&lt;/if>&amp;#10;&amp;#10;&lt;if test=&quot;Status='D' and ZyklenDurchgefuehrt>0 and not isEmptyString(Protokoll)&quot;>&amp;#10;  &lt;then>,  &lt;/then>&amp;#10;&lt;/if>&amp;#10;&amp;#10;&lt;if test=&quot;ZyklenDurchgefuehrt>0&quot;>&amp;#10;  &lt;then>&amp;#10;    &lt;if test=&quot;ZyklenDurchgefuehrt=1&quot;>&amp;#10;      &lt;then> 1 Zyklus &lt;/then>&amp;#10;      &lt;else> {ZyklenDurchgefuehrt} Zyklen &lt;/else>&amp;#10;    &lt;/if>&amp;#10;  &lt;/then>&amp;#10;&lt;/if>&amp;#10;&amp;#10;   &lt;if test=&quot;Nebenwirkungen='1' &quot;>&amp;#10;      &lt;then> &lt;br/>Nebenwirkungen aufgetreten&lt;/then> &amp;#10;   &lt;/if>&amp;#10;&amp;#10;&lt;/div>&amp;#10;&lt;!--INHERIT END--></BigSummary>
