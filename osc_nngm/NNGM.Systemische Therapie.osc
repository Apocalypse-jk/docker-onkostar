         <PlausibilityRules>
            <PlausibilityRule>
               <Type>2</Type>
               <Message>Der Therapiebeginn befindet sich nach dem Therapieende</Message>
               <Description>Der Therapiebeginn befindet sich nach dem Therapieende</Description>
               <Bezeichnung>Therapiebeginn nach Therapieende</Bezeichnung>
               <Formula>Beginn.before(Ende) or Beginn.equals(Ende)</Formula>
               <Active>true</Active>
               <Editable>true</Editable>
               <Valid>true</Valid>
               <Condition>not isEmpty(Beginn) and not isEmpty(Ende)</Condition>
               <ConditionValid>true</ConditionValid>
               <Statusauswirkung>0</Statusauswirkung>
               <DataFormEntries>
                  <EntryName>Ende</EntryName>
                  <EntryName>Beginn</EntryName>
               </DataFormEntries>
            </PlausibilityRule>
            <PlausibilityRule>
               <Type>1</Type>
               <Message>Der Therapiebeginn liegt vor dem Diagnosedatum</Message>
               <Description>Der Therapiebeginn liegt vor dem Diagnosedatum</Description>
               <Bezeichnung>Therapiebeginn vor Diagnosedatum</Bezeichnung>
               <Formula>(&amp;#10;getCurrentDisease().getDiagnosisDate().before(Datum) or getCurrentDisease().getDiagnosisDate().equals(Datum)&amp;#10;) and&amp;#10;(&amp;#10;not isEmpty(Beginn) or true&amp;#10;)</Formula>
               <Active>true</Active>
               <Editable>true</Editable>
               <Valid>true</Valid>
               <Condition>getCurrentDisease() &lt;> null and getCurrentDisease().getDiagnosisDate() &lt;> null and&amp;#10;not isEmpty(Datum)</Condition>
               <ConditionValid>true</ConditionValid>
               <Statusauswirkung>0</Statusauswirkung>
               <DataFormEntries>
                  <EntryName>Datum</EntryName>
                  <EntryName>Beginn</EntryName>
               </DataFormEntries>
            </PlausibilityRule>
            <PlausibilityRule>
               <Type>2</Type>
               <Message>Das Therapieende liegt nach dem Sterbedatum des Patienten</Message>
               <Description>Das Therapieende liegt nach dem Sterbedatum des Patienten</Description>
               <Bezeichnung>Therapieende liegt nach Sterbedatum</Bezeichnung>
               <Formula>(&amp;#10;patientData.getDeathdate().after(Ende) or patientData.getDeathdate().equals(Ende)&amp;#10;)</Formula>
               <Active>true</Active>
               <Editable>true</Editable>
               <Valid>true</Valid>
               <Condition>patientData.getDeathdate() &lt;> null and&amp;#10;not isEmpty(Ende)</Condition>
               <ConditionValid>true</ConditionValid>
               <Statusauswirkung>0</Statusauswirkung>
               <DataFormEntries>
                  <EntryName>Ende</EntryName>
               </DataFormEntries>
            </PlausibilityRule>
            <PlausibilityRule>
               <Type>2</Type>
               <Message>Das Datum liegt vor dem Geburtsdatum</Message>
               <Description>__DatumGrenze_Datum_GueltigVon</Description>
               <Bezeichnung>__DatumGrenze_Datum_GueltigVon</Bezeichnung>
               <Formula>dateBeforeOrEquals(patientData.getBirthdate(), Datum)</Formula>
               <Active>true</Active>
               <Editable>false</Editable>
               <Valid>true</Valid>
               <Statusauswirkung>0</Statusauswirkung>
               <DataFormEntries>
                  <EntryName>Datum</EntryName>
