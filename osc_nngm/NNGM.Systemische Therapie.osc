               <Bezeichnung>Therapieende liegt nach Sterbedatum</Bezeichnung>
               <Formula>(&amp;#10;patientData.getDeathdate().after(Ende) or patientData.getDeathdate().equals(Ende)&amp;#10;)</Formula>
               <Active>true</Active>
               <Editable>true</Editable>
               <Valid>true</Valid>
               <Condition>patientData.getDeathdate() &lt;> null and&amp;#10;not isEmpty(Ende)</Condition>
               <ConditionValid>true</ConditionValid>
               <Statusauswirkung>0</Statusauswirkung>
               <DataFormEntries>
                  <EntryName>Ende</EntryName>
