            </PlausibilityRule>
            <PlausibilityRule>
               <Type>2</Type>
               <Message>Das Datum liegt nach dem Sterbedatum</Message>
               <Description>__DatumGrenze_Datum_GueltigBis</Description>
               <Bezeichnung>__DatumGrenze_Datum_GueltigBis</Bezeichnung>
