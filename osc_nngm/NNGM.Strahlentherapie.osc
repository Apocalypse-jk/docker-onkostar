         <Category>-2</Category>
         <Name>NNGM.Strahlentherapie</Name>
         <Version>1</Version>
         <MenuEntry>Strahlentherapie (nNGM)</MenuEntry>
         <Title>Strahlentherapie (nNGM)</Title>
         <Description>Abgeleitet von OS.Strahlentherapie (nNGM, E-8)</Description>
         <Note>Abgeleitet von OS.Strahlentherapie mit mapping/tools/osc-ableitung.mjs; Basis-Datenkatalog Strahlentherapie, nNGM-Ergänzungen in NNGMStrahlentherapie</Note>
         <Readonly>false</Readonly>
         <Active>true</Active>
         <TudokPosition>304</TudokPosition>
         <Aktenbereich>0</Aktenbereich>
         <BefragungRelevant>false</BefragungRelevant>
         <Hotkey>strg+shift+r</Hotkey>
         <Summary>&lt;!--INHERIT START-->&amp;#10;&lt;div style=&quot;margin-left:10px&quot;>&amp;#10;&amp;#10;&lt;font style=&quot;font-weight: bold;color: purple&quot;>{Therapieart.longdesc}&lt;/font>&amp;#10;&amp;#10;&lt;if test=&quot;not isEmptyString(Intention) and not isEmptyString(Relation)&quot;>&amp;#10;&lt;then>({Intention.shortdesc}, {Relation.shortdesc})&lt;/then>&lt;/if>&amp;#10;&lt;if test=&quot;not isEmptyString(Intention) and isEmptyString(Relation)&quot;>&amp;#10;&lt;then>{Intention.shortdesc}&lt;/then>&lt;/if>&amp;#10;&lt;if test=&quot;not isEmptyString(Relation) and isEmptyString(Intention)&quot;>&amp;#10;&lt;then>{Relation.shortdesc}&lt;/then>&lt;/if>&amp;#10;&amp;#10;&lt;if test=&quot;not isEmpty(Ende) and Status='D' and Beendigungsstatus &lt;> 'A' &quot;>&amp;#10;  &lt;then>&amp;#10;  &lt;br/>beendet am {Ende}&amp;#10;  &lt;/then>&amp;#10;&lt;/if>&amp;#10;&lt;if test=&quot;isEmpty(Ende) and Status='D' and Beendigungsstatus &lt;> 'A' &quot;>&amp;#10;  &lt;then>&amp;#10;  &amp;#10;  &lt;/then>&amp;#10;&lt;/if>&amp;#10;&amp;#10;&lt;if test=&quot;Status='D' and Beendigungsstatus = 'A' &quot;>&amp;#10;  &lt;then>&amp;#10;  &lt;br/>abgebrochen &amp;#10;  &lt;/then>&amp;#10;&lt;/if>&amp;#10;&lt;if test=&quot;not isEmpty(Ende) and Status='D' and Beendigungsstatus = 'A' &quot;>&amp;#10;  &lt;then>&amp;#10;  am {Ende}&amp;#10;  &lt;/then>&amp;#10;&lt;/if>&amp;#10;&lt;if test=&quot;not isEmptyString(GrundAbbruch) and Status='D' and Beendigungsstatus = 'A' &quot;>&amp;#10;  &lt;then>&amp;#10;   &amp;nbsp ({GrundAbbruch.shortdesc})&amp;#10;  &lt;/then>&amp;#10;&lt;/if>&amp;#10;&amp;#10;&lt;if test=&quot;Status='N' &quot;>&amp;#10;  &lt;then>&amp;#10;  &lt;br/>Nicht durchgeführt&amp;#10;  &lt;/then>&amp;#10;&lt;/if>&amp;#10;&amp;#10;&lt;if test=&quot;Status='N' and not isEmptyString(Grund)&quot;>&amp;#10;  &lt;then>&amp;#10; ({Grund.shortdesc})&amp;#10; &lt;/then>&amp;#10;&lt;/if>&amp;#10;&amp;#10;&lt;if test=&quot;Gesamtdosis>0&quot;>&amp;#10;  &lt;then>&amp;#10;  &lt;br/> Gesamtdosis: {Gesamtdosis} Gy&amp;#10;  &lt;/then>&amp;#10;&lt;/if>&amp;#10;&amp;#10;   &lt;if test=&quot;Nebenwirkungen='1' &quot;>&amp;#10;      &lt;then> &lt;br/>Nebenwirkungen aufgetreten&lt;/then> &amp;#10;   &lt;/if>&amp;#10;&amp;#10;&lt;/div>&amp;#10;&lt;!--INHERIT END--></Summary>
         <BigSummary>&lt;!--INHERIT START-->&amp;#10;&lt;div style=&quot;margin-left:20px&quot;>&amp;#10;&amp;#10;&lt;font style=&quot;font-weight: bold;color: purple;font-size: 16px;&quot;>{Therapieart.longdesc}&lt;/font>&amp;#10;&amp;#10;&lt;if test=&quot;not isEmptyString(Intention) and not isEmptyString(Relation)&quot;>&amp;#10;&lt;then>({Intention.shortdesc}, {Relation.shortdesc})&lt;/then>&lt;/if>&amp;#10;&lt;if test=&quot;not isEmptyString(Intention) and isEmptyString(Relation)&quot;>&amp;#10;&lt;then>{Intention.shortdesc}&lt;/then>&lt;/if>&amp;#10;&lt;if test=&quot;not isEmptyString(Relation) and isEmptyString(Intention)&quot;>&amp;#10;&lt;then>{Relation.shortdesc}&lt;/then>&lt;/if>&amp;#10;&amp;#10;&lt;if test=&quot;not isEmpty(Ende) and Status='D' and Beendigungsstatus &lt;> 'A' &quot;>&amp;#10;  &lt;then>&amp;#10;  &lt;br/>beendet am {Ende}&amp;#10;  &lt;/then>&amp;#10;&lt;/if>&amp;#10;&lt;if test=&quot;isEmpty(Ende) and Status='D' and Beendigungsstatus &lt;> 'A' &quot;>&amp;#10;  &lt;then>&amp;#10;  &amp;#10;  &lt;/then>&amp;#10;&lt;/if>&amp;#10;&amp;#10;&lt;if test=&quot;Status='D' and Beendigungsstatus = 'A' &quot;>&amp;#10;  &lt;then>&amp;#10;  &lt;br/>abgebrochen &amp;#10;  &lt;/then>&amp;#10;&lt;/if>&amp;#10;&lt;if test=&quot;not isEmpty(Ende) and Status='D' and Beendigungsstatus = 'A' &quot;>&amp;#10;  &lt;then>&amp;#10;  am {Ende}&amp;#10;  &lt;/then>&amp;#10;&lt;/if>&amp;#10;&lt;if test=&quot;not isEmptyString(GrundAbbruch) and Status='D' and Beendigungsstatus = 'A' &quot;>&amp;#10;  &lt;then>&amp;#10;   &amp;nbsp ({GrundAbbruch.shortdesc})&amp;#10;  &lt;/then>&amp;#10;&lt;/if>&amp;#10;&amp;#10;&lt;if test=&quot;Status='N' &quot;>&amp;#10;  &lt;then>&amp;#10;  &lt;br/>Nicht durchgeführt&amp;#10;  &lt;/then>&amp;#10;&lt;/if>&amp;#10;&amp;#10;&lt;if test=&quot;Status='N' and not isEmptyString(Grund)&quot;>&amp;#10;  &lt;then>&amp;#10; ({Grund.shortdesc})&amp;#10; &lt;/then>&amp;#10;&lt;/if>&amp;#10;&amp;#10;&lt;if test=&quot;Gesamtdosis>0&quot;>&amp;#10;  &lt;then>&amp;#10;  &lt;br/> Gesamtdosis: {Gesamtdosis} Gy&amp;#10;  &lt;/then>&amp;#10;&lt;/if>&amp;#10;&amp;#10;   &lt;if test=&quot;Nebenwirkungen='1' &quot;>&amp;#10;      &lt;then> &lt;br/>Nebenwirkungen aufgetreten&lt;/then> &amp;#10;   &lt;/if>&amp;#10;&amp;#10;&lt;/div>&amp;#10;&lt;!--INHERIT END--></BigSummary>
