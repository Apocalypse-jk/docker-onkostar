         <Summary>&lt;!--INHERIT START-->&amp;#10;&lt;div style=&quot;margin-left:10px&quot;>&amp;#10;&amp;#10; &lt;if test=&quot;Intention='K' or Intention='P'&quot;>&amp;#10;      &lt;then> &amp;#10;      &lt;font style=&quot;font-weight: bold;color:purple;text-decoration:underline&quot;>Operation&lt;/font>&amp;#10;     &lt;/then>&amp;#10;  &lt;/if>  &amp;#10; &amp;#10;  &lt;if test=&quot;Intention='R' &quot;>&amp;#10;     &lt;then> &amp;#10;      &lt;font style=&quot;font-weight: bold;color: purple&quot;>Revisionsoperation&lt;/font>&amp;#10;      &lt;/then>&amp;#10;  &lt;/if>&amp;#10;&amp;#10; &lt;if test=&quot;Intention='D' &quot;>&amp;#10;     &lt;then> &amp;#10;      &lt;font style=&quot;font-weight: bold;color:blue&quot;>Diagnostische OP&lt;/font>&amp;#10;      &lt;/then>&amp;#10;  &lt;/if>&amp;#10;&amp;#10;  &lt;if test=&quot;not (Intention='R' or Intention='K' or Intention='P' or Intention='D')&quot;>&amp;#10;        &lt;then>&amp;#10;        &lt;font style=&quot;font-weight: bold;color: purple&quot;>Operation&lt;/font>&amp;#10;        &lt;/then>&amp;#10;  &lt;/if>&amp;#10;           &amp;#10;  &lt;if test=&quot;ElektivNotfall='N'&quot;>&amp;#10;      &lt;then>&amp;#10;      &lt;font style=&quot;color:purple&quot;>(Notfall)&lt;/font>&amp;#10;      &lt;/then>&amp;#10;  &lt;/if>&amp;#10;           &amp;#10; &lt;if test=&quot;Status='N' &quot;>&amp;#10;    &lt;then> &lt;br/> Nicht durchgeführt &lt;/then>&lt;else>&lt;/else>&amp;#10; &lt;/if>&amp;#10;&amp;#10; &lt;if test=&quot;not isEmptyString(Grund) and Status='N' &quot;>&amp;#10;    &lt;then> ({Grund.shortdesc}) &lt;/then>&lt;else>&lt;/else>&lt;/if> &amp;#10;&amp;#10;  &lt;for var=&quot;uf&quot; src=&quot;OPS&quot;>&amp;#10;     &lt;if test=&quot;Status='D' and not isEmptyString(uf.OPSCode) and uf.Massgeblich&quot;>&amp;#10;        &lt;then> &lt;br/> {uf.OPSCode}&lt;/then>&amp;#10;        &lt;else>&lt;/else>&amp;#10;      &lt;/if> &amp;#10;  &lt;/for> &amp;#10;  &amp;#10;  &lt;if test=&quot;not isEmptyString(RKlassifikation) and RDefinitiv=true &quot;>&amp;#10;      &lt;then> &lt;br/> &lt;font style=&quot;font-weight: bold;text-decoration:underline&quot;>  R-Lokal {RKlassifikation.shortdesc}&lt;/font> &amp;#10;      &lt;/then>&amp;#10;      &lt;else>&lt;/else>&amp;#10;   &lt;/if> &amp;#10;&amp;#10;  &lt;if test=&quot;not isEmptyString(RKlassifikation) and RDefinitiv=false &quot;>&amp;#10;      &lt;then> &lt;br/> {RKlassifikation.shortdesc} &amp;#10;       &lt;/then> &amp;#10;       &lt;else>&lt;/else>&amp;#10;  &lt;/if>&amp;#10;&amp;#10;   &lt;if test=&quot;Komplikationen='1' &quot;>&amp;#10;      &lt;then> &lt;br/> Komplikationen aufgetreten  &lt;/then> &amp;#10;   &lt;/if> &amp;#10;&amp;#10;&amp;#10;&lt;/div>&amp;#10;&lt;!--INHERIT END--></Summary>
